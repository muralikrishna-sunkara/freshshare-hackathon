# Copy to terraform.tfvars (git-ignored) for local runs. CI uses the defaults
# plus TF_VAR_* values from GitHub environment variables.

region      = "eu-central-1"
environment = "dev"

# Leave empty to use the ALB DNS name over plain HTTP.
domain_name     = ""             # e.g. "app.dev.freshshare.food"
route53_zone_id = ""             # if the zone is in Route 53
certificate_arn = ""             # or bring an ACM cert if DNS is elsewhere

instance_type = "t3.small"
asg_min_size  = 1
asg_max_size  = 3

ops_alert_emails = ["you@example.com"]

# Leave null for the hello-world placeholder; CI sets real images later.
# api_image = "<account>.dkr.ecr.eu-central-1.amazonaws.com/freshshare-dev/api:<sha>"
# web_image = "<account>.dkr.ecr.eu-central-1.amazonaws.com/freshshare-dev/web:<sha>"
