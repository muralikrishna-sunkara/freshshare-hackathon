# Local (compose): APP_DOMAIN defaults to localhost. On ECS: APP_DOMAIN=:80, TLS ends at the ALB,
# and the ALB sends /api/* straight to the api service, so the proxy below is only used locally.
{
	admin off
}

{$APP_DOMAIN:localhost} {
	encode gzip
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:4000}
	}
	handle /uploads/* {
		reverse_proxy {$API_UPSTREAM:api:4000}
	}
	handle {
		root * /srv/www
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
