{
  "name": "freshshare",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:clean-test": "npm run db:clean-test -w apps/api",
    "e2e": "playwright test --trace off",
    "demo:video": "tsx demo/video.ts",
    "demo:reset": "tsx demo/reset.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "msedge-tts": "^2.1.1"
  }
}
