# Copy to .env for `npm run dev`. On AWS these come from the ECS task definition / Secrets Manager.
DATABASE_URL=postgresql://freshshare:freshshare@localhost:5432/freshshare
JWT_SECRET=change-me-locally
# Sign-in attempts per IP per 15 min (default 30). The full Playwright suite signs in ~35 times from one IP, so raise it locally.
AUTH_RATE_LIMIT=200
PORT=4000
APP_URL=http://localhost:5173
# local = write to UPLOADS_DIR and serve /uploads; s3 = write to S3_BUCKET, URLs under PUBLIC_IMAGE_BASE_URL
STORAGE_DRIVER=local
# Notification emails: log (print only), smtp (Mailpit at MAILPIT_URL: docker run -p 8025:8025 axllent/mailpit), ses (AWS)
EMAIL_TRANSPORT=log
MAILPIT_URL=http://localhost:8025
UPLOADS_DIR=uploads
PUBLIC_IMAGE_BASE_URL=/uploads
S3_BUCKET=
AWS_REGION=eu-central-1
SNS_NOTIFICATIONS_ARN=
# Web (Caddy): ":80" on ECS, "localhost" for local HTTPS
APP_DOMAIN=:80
# Web push (T2.2): run `npm run vapid -w apps/api` and paste the line here. Empty = push off.
VAPID_PRIVATE_KEY_PEM=
# Photo autofill (K1): Anthropic API key from console.anthropic.com. Empty = the "Fill from photo" button is hidden.
AI_API_KEY=
AI_MODEL=claude-opus-5-5
