generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  leftovers
  fruit_veg
  bread
  packaged
  dairy
  other
}

enum Origin {
  homemade
  packaged
  fresh_produce
}

enum ListingStatus {
  available
  reserved
  collected
  expired
  removed
}

enum ClaimStatus {
  pending
  confirmed
  collected
  cancelled
  lapsed
  declined
}

enum ReportReason {
  unsafe_food
  prohibited_item
  spam
  no_show
  harassment
  other
}

enum NotificationType {
  claim_received
  claim_confirmed
  claim_cancelled
  new_message
  listing_expiring_soon
  new_listing_nearby
  waitlist_offer
  fridge_approved
  org_approved
}

enum ReportStatus {
  open
  resolved
}

enum UserRole {
  user
  admin
}

enum EarlyAccessRole {
  giver
  receiver
  business
  fridge_host
  organization
}

enum FridgeKind {
  fridge
  pantry
  dropoff
}

enum FridgeStatus {
  pending
  active
  inactive
  rejected
}

enum FillLevel {
  empty
  low
  half
  full
}

enum OrgType {
  food_bank
  ngo
  charity
  community_center
  religious_org
  other
}

enum OrgStatus {
  pending
  under_review
  approved
  rejected
  suspended
}

enum OrgRole {
  admin
  manager
  volunteer
  viewer
}

enum BulkClaimStatus {
  pending
  in_progress
  partially_completed
  completed
  cancelled
}

enum FridgeState {
  stocked
  empty
  needs_cleaning
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String
  name               String
  homeLat            Float
  homeLng            Float
  emailVerified      Boolean        @default(false)
  phoneVerified      Boolean        @default(false)
  ratingAvg          Float          @default(0)
  ratingCount        Int            @default(0)
  role               UserRole       @default(user)
  bio                String?
  termsAcceptedAt    DateTime?
  termsVersion       String?
  emailNotifications Boolean        @default(true)
  suspendedAt        DateTime?
  suspendedReason    String?
  createdAt          DateTime       @default(now())
  listings           Listing[]
  claims             Claim[]
  notifications      Notification[]
}

model Listing {
  id                String            @id @default(cuid())
  giverId           String
  giver             User              @relation(fields: [giverId], references: [id])
  title             String
  description       String?
  category          Category
  origin            Origin
  allergens         String[]
  bestBefore        DateTime
  photoUrl          String
  photos            String[]
  dietaryTags       String[]
  weightKg          Float?
  postcode          String?
  areaName          String?
  lat               Float
  lng               Float
  publicLat         Float
  publicLng         Float
  handoverSpot      String?
  fridgeId          String?
  fridge            Fridge?           @relation(fields: [fridgeId], references: [id])
  pickupFrom        DateTime
  pickupUntil       DateTime
  portions          Int               @default(1)
  status            ListingStatus     @default(available)
  // T2.3 waitlist: after a cancelled claim the first person in line gets an exclusive hold.
  reservedForUserId String?
  reservedUntil     DateTime?
  scheduleId        String?
  createdAt         DateTime          @default(now())
  claims            Claim[]
  waitlist          ListingWaitlist[]

  @@index([status, lat, lng])
}

model Claim {
  id             String         @id @default(cuid())
  listingId      String
  listing        Listing        @relation(fields: [listingId], references: [id])
  receiverId     String
  receiver       User           @relation(fields: [receiverId], references: [id])
  status         ClaimStatus    @default(pending)
  holdUntil      DateTime
  organizationId String?
  bulkClaimId    String?
  pickupCode     String?
  createdAt      DateTime       @default(now())
  messages       Message[]
  ratings        Rating[]
  bulkItem       BulkClaimItem?
}

model Message {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id])
  senderId  String
  body      String
  createdAt DateTime @default(now())
}

model Rating {
  id         String   @id @default(cuid())
  claimId    String
  claim      Claim    @relation(fields: [claimId], references: [id])
  fromUserId String
  toUserId   String
  stars      Int
  note       String?
  createdAt  DateTime @default(now())

  @@unique([claimId, fromUserId])
}

model Fridge {
  id           String          @id @default(cuid())
  name         String
  kind         FridgeKind      @default(fridge)
  description  String?
  address      String
  lat          Float
  lng          Float
  openingHours String
  accessNotes  String?
  photoUrl     String?
  status       FridgeStatus    @default(active)
  createdById  String?
  reviewedById String?
  createdAt    DateTime        @default(now())
  checkIns     FridgeCheckIn[]
  listings     Listing[]

  @@index([status])
}

model FridgeCheckIn {
  id        String      @id @default(cuid())
  fridgeId  String
  fridge    Fridge      @relation(fields: [fridgeId], references: [id])
  userId    String
  state     FridgeState
  fillLevel FillLevel?
  contents  String?
  createdAt DateTime    @default(now())
}

model Organization {
  id                 String                 @id @default(cuid())
  name               String
  type               OrgType
  email              String
  website            String?
  address            String
  city               String
  lat                Float
  lng                Float
  description        String
  mission            String?
  serviceArea        String?
  contactName        String
  registrationNumber String?
  logoUrl            String?
  status             OrgStatus              @default(pending)
  createdById        String
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime               @default(now())
  members            OrganizationMember[]
  documents          OrganizationDocument[]
  bulkClaims         BulkClaim[]

  @@index([status])
}

/// Verification documents live in Postgres (not the public photo bucket) so only site admins and org admins can read them.
model OrganizationDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  filename       String
  contentType    String
  size           Int
  data           Bytes
  createdAt      DateTime     @default(now())
}

model OrganizationMember {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  role           OrgRole
  joinedAt       DateTime     @default(now())

  @@id([organizationId, userId])
  @@index([userId])
}

model BulkClaim {
  id                  String          @id @default(cuid())
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id])
  createdById         String
  name                String
  notes               String?
  scheduledPickupDate DateTime
  status              BulkClaimStatus @default(pending)
  createdAt           DateTime        @default(now())
  completedAt         DateTime?
  items               BulkClaimItem[]
}

model BulkClaimItem {
  id          String    @id @default(cuid())
  bulkClaimId String
  bulkClaim   BulkClaim @relation(fields: [bulkClaimId], references: [id], onDelete: Cascade)
  listingId   String
  claimId     String    @unique
  claim       Claim     @relation(fields: [claimId], references: [id])
  isCollected Boolean   @default(false)
  collectedAt DateTime?

  @@unique([bulkClaimId, listingId])
}

model AlertSubscription {
  id         String     @id @default(cuid())
  userId     String
  lat        Float
  lng        Float
  radiusM    Int        @default(2000)
  categories Category[]
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  listingId String?
  claimId   String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Setting {
  key   String @id
  value String
}

model Report {
  id             String       @id @default(cuid())
  listingId      String?
  reportedUserId String?
  userId         String
  reason         ReportReason
  note           String?
  status         ReportStatus @default(open)
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([status])
}

model EarlyAccessSignup {
  id        String          @id @default(cuid())
  email     String          @unique
  role      EarlyAccessRole
  postcode  String?
  source    String?
  language  String?
  consentAt DateTime
  createdAt DateTime        @default(now())

  @@index([role])
  @@index([source])
}

model ListingWaitlist {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  position  Int
  createdAt DateTime @default(now())

  @@unique([listingId, userId])
  @@index([listingId, position])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// T2.2: one row per browser/device that allowed push notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// T2.4: a template a giver (usually a business) re-posts on chosen weekdays.
model ListingSchedule {
  id             String   @id @default(cuid())
  userId         String
  title          String
  description    String?
  category       Category
  origin         Origin
  allergens      String[]
  dietaryTags    String[]
  portions       Int      @default(1)
  weightKg       Float?
  handoverSpot   String?
  photos         String[]
  /// 0 = Sunday ... 6 = Saturday (Europe/Berlin)
  daysOfWeek     Int[]
  /// "HH:MM" Europe/Berlin: when the listing goes up and pickup starts
  time           String
  pickupHours    Int      @default(3)
  /// best-before = posting day + this many days
  bestBeforeDays Int      @default(1)
  active         Boolean  @default(true)
  lastPostedOn   String?
  createdAt      DateTime @default(now())

  @@index([active])
}

/// Password reset links: only a SHA-256 of the token is stored; valid for one hour, once.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
