{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../apps/api/node_modules/@types", "../node_modules/@types"]
  },
  "include": ["**/*.ts"],
  "exclude": ["out"]
}
